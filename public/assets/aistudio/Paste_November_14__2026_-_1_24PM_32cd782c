<!DOCTYPE html>
<html lang="am" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ቀላል የቁማር እና የእድል ጨዋታ - Simple Betting Game</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Noto Sans Ethiopic -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Ethiopic:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <!-- Phosphor Icons -->
    <script src="https://unpkg.com/@phosphor-icons/web"></script>

    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Noto Sans Ethiopic"', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Noto Sans Ethiopic', sans-serif;
            background: radial-gradient(circle at top, #1e293b 0%, #090d16 100%);
            color: #f8fafc;
            min-height: 100vh;
        }

        /* 3D Dice & Coin Animations */
        .perspective-container {
            perspective: 800px;
        }

        @keyframes diceShake {
            0% { transform: rotateX(0deg) rotateY(0deg) scale(1); }
            20% { transform: rotateX(140deg) rotateY(90deg) scale(1.12); }
            40% { transform: rotateX(260deg) rotateY(210deg) scale(0.95); }
            60% { transform: rotateX(380deg) rotateY(300deg) scale(1.15); }
            80% { transform: rotateX(500deg) rotateY(420deg) scale(1.05); }
            100% { transform: rotateX(720deg) rotateY(720deg) scale(1); }
        }

        .animate-dice-roll {
            animation: diceShake 0.85s cubic-bezier(0.22, 1, 0.36, 1);
        }

        @keyframes coinSpin {
            0% { transform: rotateY(0deg) translateY(0px) scale(1); }
            25% { transform: rotateY(540deg) translateY(-28px) scale(1.15); }
            50% { transform: rotateY(1080deg) translateY(-38px) scale(1.2); }
            75% { transform: rotateY(1620deg) translateY(-18px) scale(1.1); }
            100% { transform: rotateY(2160deg) translateY(0px) scale(1); }
        }

        .animate-coin-flip {
            animation: coinSpin 0.95s cubic-bezier(0.25, 1, 0.5, 1);
        }

        @keyframes popWin {
            0% { transform: scale(0.85); opacity: 0; }
            60% { transform: scale(1.06); opacity: 1; }
            100% { transform: scale(1); opacity: 1; }
        }

        .animate-pop-win {
            animation: popWin 0.35s ease-out forwards;
        }

        /* Dice Dot Grid */
        .dice-face {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            grid-template-rows: repeat(3, 1fr);
            gap: 6px;
            padding: 16px;
            background: linear-gradient(145deg, #ffffff, #e2e8f0);
            box-shadow: inset 0 -6px 12px rgba(0,0,0,0.18), 0 14px 30px rgba(0,0,0,0.55);
        }

        .pip {
            width: 18px;
            height: 18px;
            border-radius: 9999px;
            background: #0f172a;
            box-shadow: inset 0 2px 3px rgba(0,0,0,0.6);
            margin: auto;
        }
        .pip.red {
            background: #e11d48;
        }
    </style>
</head>
<body class="antialiased pb-12 selection:bg-amber-500 selection:text-slate-950">

    <!-- Header & Virtual Wallet Bar -->
    <header class="sticky top-0 z-30 bg-slate-950/85 backdrop-blur-md border-b border-slate-800/80 shadow-xl">
        <div class="max-w-4xl mx-auto px-4 py-3.5 flex flex-wrap items-center justify-between gap-3">
            <!-- Brand Title -->
            <div class="flex items-center gap-3">
                <div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-amber-400 to-amber-600 flex items-center justify-center text-slate-950 shadow-lg shadow-amber-500/20">
                    <i class="ph-fill ph-crown text-2xl"></i>
                </div>
                <div>
                    <h1 class="text-lg sm:text-xl font-extrabold tracking-tight text-white flex items-center gap-2">
                        <span>የእድል ጨዋታ</span>
                        <span class="text-[11px] font-bold uppercase px-2 py-0.5 rounded-full bg-amber-500/15 text-amber-400 border border-amber-500/30">VIP</span>
                    </h1>
                    <p class="text-xs text-slate-400">ቀላል እና ፈጣን የቨርቹዋል ውርርድ ሲስተም</p>
                </div>
            </div>

            <!-- Wallet & Controls -->
            <div class="flex items-center gap-2.5 ml-auto sm:ml-0">
                <!-- Balance Display -->
                <div class="bg-slate-900 border border-amber-500/40 rounded-2xl px-4 py-2 flex items-center gap-2.5 shadow-inner">
                    <div class="text-amber-400">
                        <i class="ph-fill ph-coins text-xl"></i>
                    </div>
                    <div>
                        <span class="block text-[10px] font-semibold text-slate-400 leading-none">ቀሪ ሂሳብ</span>
                        <span id="balanceDisplay" class="text-base sm:text-lg font-black text-amber-400 tracking-wide">1,000.00 ብር</span>
                    </div>
                </div>

                <!-- Top-up Button -->
                <button id="topUpBtn" onclick="topUpBalance()" title="ሂሳብ ሙላ (1,000 ብር)"
                    class="bg-emerald-600 hover:bg-emerald-500 active:scale-95 transition text-white px-3.5 py-2.5 rounded-2xl text-xs sm:text-sm font-bold flex items-center gap-1.5 shadow-lg shadow-emerald-600/20 cursor-pointer">
                    <i class="ph-bold ph-plus-circle text-lg"></i>
                    <span class="hidden sm:inline">ሂሳብ ሙላ (1,000 ብር)</span>
                    <span class="sm:hidden">ሙላ</span>
                </button>

                <!-- Sound Toggle Button -->
                <button id="soundToggleBtn" onclick="toggleSound()" title="ድምጽ አብራ/አጥፋ"
                    class="w-10 h-10 rounded-2xl bg-slate-800 hover:bg-slate-700 border border-slate-700 flex items-center justify-center text-slate-200 transition cursor-pointer">
                    <i id="soundIcon" class="ph-fill ph-speaker-high text-xl text-amber-400"></i>
                </button>
            </div>
        </div>
    </header>

    <!-- Toast / Inline Alert Banner -->
    <div id="toastBanner" class="fixed bottom-5 right-5 left-5 sm:left-auto z-50 transform translate-y-28 opacity-0 transition-all duration-300 pointer-events-none">
        <div id="toastCard" class="bg-slate-900 border border-slate-700 text-white px-5 py-3.5 rounded-2xl shadow-2xl flex items-center gap-3 max-w-md mx-auto">
            <i id="toastIcon" class="ph-fill ph-info text-2xl text-amber-400"></i>
            <p id="toastText" class="text-sm font-bold"></p>
        </div>
    </div>

    <main class="max-w-4xl mx-auto px-4 pt-6 space-y-6">

        <!-- Game Mode Selector Tabs -->
        <nav aria-label="የጨዋታ ምርጫ" class="grid grid-cols-3 gap-2.5 bg-slate-900/90 p-2 rounded-2xl border border-slate-800 shadow-lg">
            <button onclick="switchGame('dice')" id="tab-dice"
                class="game-tab py-3 px-3 rounded-xl font-bold text-xs sm:text-sm flex flex-col sm:flex-row items-center justify-center gap-1.5 sm:gap-2 transition cursor-pointer bg-gradient-to-r from-amber-500 to-amber-600 text-slate-950 shadow-md">
                <i class="ph-fill ph-dice-five text-xl"></i>
                <span>የዳይስ ጨዋታ</span>
            </button>

            <button onclick="switchGame('coin')" id="tab-coin"
                class="game-tab py-3 px-3 rounded-xl font-bold text-xs sm:text-sm flex flex-col sm:flex-row items-center justify-center gap-1.5 sm:gap-2 transition cursor-pointer text-slate-300 hover:bg-slate-800">
                <i class="ph-fill ph-coin text-xl"></i>
                <span>የሳንቲም ውርርድ</span>
            </button>

            <button onclick="switchGame('lucky')" id="tab-lucky"
                class="game-tab py-3 px-3 rounded-xl font-bold text-xs sm:text-sm flex flex-col sm:flex-row items-center justify-center gap-1.5 sm:gap-2 transition cursor-pointer text-slate-300 hover:bg-slate-800">
                <i class="ph-fill ph-sparkle text-xl"></i>
                <span>የእድል ቁጥር (1-20)</span>
            </button>
        </nav>

        <!-- Main Arena Card -->
        <section class="bg-slate-900/95 border border-slate-800 rounded-3xl p-5 sm:p-8 shadow-2xl relative overflow-hidden">
            <!-- Subtle Ambient Glow -->
            <div class="absolute -top-24 -right-24 w-64 h-64 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
            <div class="absolute -bottom-24 -left-24 w-64 h-64 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none"></div>

            <!-- 1. EXPANDED DICE GAME -->
            <div id="panel-dice" class="game-panel space-y-6">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-800 pb-4">
                    <div>
                        <h2 class="text-xl sm:text-2xl font-extrabold text-white">🎲 የዳይስ ጨዋታ (ቁጥሮች 1 - 100)</h2>
                        <p id="diceModeSubtitle" class="text-xs sm:text-sm text-slate-400 mt-0.5">የዳይስ አይነት ይምረጡ እና ትክክለኛውን ቁጥር ወይም ክልል ይገምቱ!</p>
                    </div>
                    <span id="diceCurrentMultiplierBadge" class="self-start sm:self-center px-3 py-1 rounded-full text-xs font-extrabold bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
                        ሽልማት: 2x
                    </span>
                </div>

                <!-- Dice Mode Sub-Selector -->
                <div class="grid grid-cols-3 gap-2 bg-slate-950/90 p-1.5 rounded-2xl border border-slate-800">
                    <button type="button" onclick="setDiceSubMode('single')" id="diceSub-single"
                        class="dice-sub-btn py-2.5 px-2 rounded-xl text-xs sm:text-sm font-extrabold transition cursor-pointer bg-amber-500 text-slate-950 shadow">
                        ባለ 1 ዳይስ (1-6)
                    </button>
                    <button type="button" onclick="setDiceSubMode('double')" id="diceSub-double"
                        class="dice-sub-btn py-2.5 px-2 rounded-xl text-xs sm:text-sm font-extrabold transition cursor-pointer text-slate-300 hover:bg-slate-800">
                        ባለ 2 ዳይስ (2-12)
                    </button>
                    <button type="button" onclick="setDiceSubMode('d100')" id="diceSub-d100"
                        class="dice-sub-btn py-2.5 px-2 rounded-xl text-xs sm:text-sm font-extrabold transition cursor-pointer text-slate-300 hover:bg-slate-800">
                        ባለ 100 ዳይስ (1-100)
                    </button>
                </div>

                <!-- Visual Stage -->
                <div class="bg-slate-950/80 border border-slate-800/90 rounded-2xl py-7 px-4 flex flex-col items-center justify-center min-h-[210px] perspective-container">
                    <!-- Single Die Visual -->
                    <div id="diceStageSingle" class="flex items-center justify-center">
                        <div id="diceVisual" class="w-28 h-28 rounded-2xl dice-face transition-transform">
                            <div class="pip"></div><div></div><div class="pip"></div>
                            <div></div><div class="pip red"></div><div></div>
                            <div class="pip"></div><div></div><div class="pip"></div>
                        </div>
                    </div>

                    <!-- Double Dice Visual -->
                    <div id="diceStageDouble" class="hidden flex flex-col items-center">
                        <div class="flex items-center gap-4 sm:gap-6">
                            <div id="diceVisual1" class="w-24 h-24 sm:w-28 sm:h-28 rounded-2xl dice-face transition-transform">
                                <div class="pip"></div><div></div><div class="pip"></div>
                                <div></div><div></div><div></div>
                                <div class="pip"></div><div></div><div class="pip"></div>
                            </div>
                            <div id="diceVisual2" class="w-24 h-24 sm:w-28 sm:h-28 rounded-2xl dice-face transition-transform">
                                <div class="pip"></div><div></div><div></div>
                                <div></div><div class="pip"></div><div></div>
                                <div></div><div></div><div class="pip"></div>
                            </div>
                        </div>
                        <div id="doubleDiceSumBadge" class="mt-3 px-3.5 py-1 rounded-full bg-slate-900 border border-slate-700 text-xs font-extrabold text-amber-400">
                            ድምር: 7
                        </div>
                    </div>

                    <!-- 1-100 Digital Die Visual -->
                    <div id="diceStageD100" class="hidden flex flex-col items-center">
                        <div id="d100VisualBox" class="w-36 h-32 rounded-3xl bg-gradient-to-br from-slate-800 via-slate-900 to-slate-950 border-2 border-amber-500/60 shadow-[0_0_35px_rgba(245,158,11,0.25)] flex flex-col items-center justify-center relative">
                            <span class="text-[10px] font-bold uppercase tracking-widest text-slate-400">D100 ቁጥር</span>
                            <span id="d100NumberDisplay" class="text-5xl sm:text-6xl font-black text-amber-400 tracking-tight mt-0.5">50</span>
                        </div>
                    </div>

                    <p id="diceStatusLabel" class="mt-4 text-sm font-bold text-slate-400 text-center">ምርጫዎን ይምረጡና ዳይሱን ይወርውሩ</p>
                </div>

                <!-- MODE A: SINGLE DIE CONTROLS (1-6) -->
                <div id="controls-dice-single" class="space-y-4">
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">1ሀ. ዝቅተኛ ወይም ከፍተኛ ይምረጡ (2x)</label>
                        <div class="grid grid-cols-2 gap-3">
                            <button type="button" onclick="selectSingleDiceBet('low', null)" id="btnSingle-low"
                                class="single-dice-btn p-3.5 rounded-2xl border-2 border-amber-500 bg-amber-500/15 text-white flex flex-col items-center justify-center transition cursor-pointer">
                                <span class="text-base font-black text-amber-400">ዝቅተኛ (1 - 3)</span>
                                <span class="text-[11px] text-slate-300">ሽልማት: 2x</span>
                            </button>
                            <button type="button" onclick="selectSingleDiceBet('high', null)" id="btnSingle-high"
                                class="single-dice-btn p-3.5 rounded-2xl border-2 border-slate-800 bg-slate-950/60 hover:border-slate-700 text-slate-300 flex flex-col items-center justify-center transition cursor-pointer">
                                <span class="text-base font-black">ከፍተኛ (4 - 6)</span>
                                <span class="text-[11px] text-slate-400">ሽልማት: 2x</span>
                            </button>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">1ለ. ወይም ትክክለኛ ቁጥር ይምረጡ (5.5x)</label>
                        <div class="grid grid-cols-6 gap-2">
                            <button type="button" onclick="selectSingleDiceBet('exact', 1)" id="btnSingleExact-1" class="single-dice-btn py-3 rounded-xl border-2 border-slate-800 bg-slate-950/60 hover:border-slate-700 text-slate-200 font-black text-lg transition cursor-pointer">1</button>
                            <button type="button" onclick="selectSingleDiceBet('exact', 2)" id="btnSingleExact-2" class="single-dice-btn py-3 rounded-xl border-2 border-slate-800 bg-slate-950/60 hover:border-slate-700 text-slate-200 font-black text-lg transition cursor-pointer">2</button>
                            <button type="button" onclick="selectSingleDiceBet('exact', 3)" id="btnSingleExact-3" class="single-dice-btn py-3 rounded-xl border-2 border-slate-800 bg-slate-950/60 hover:border-slate-700 text-slate-200 font-black text-lg transition cursor-pointer">3</button>
                            <button type="button" onclick="selectSingleDiceBet('exact', 4)" id="btnSingleExact-4" class="single-dice-btn py-3 rounded-xl border-2 border-slate-800 bg-slate-950/60 hover:border-slate-700 text-slate-200 font-black text-lg transition cursor-pointer">4</button>
                            <button type="button" onclick="selectSingleDiceBet('exact', 5)" id="btnSingleExact-5" class="single-dice-btn py-3 rounded-xl border-2 border-slate-800 bg-slate-950/60 hover:border-slate-700 text-slate-200 font-black text-lg transition cursor-pointer">5</button>
                            <button type="button" onclick="selectSingleDiceBet('exact', 6)" id="btnSingleExact-6" class="single-dice-btn py-3 rounded-xl border-2 border-slate-800 bg-slate-950/60 hover:border-slate-700 text-slate-200 font-black text-lg transition cursor-pointer">6</button>
                        </div>
                    </div>
                </div>

                <!-- MODE B: DOUBLE DICE CONTROLS (SUM 2-12) -->
                <div id="controls-dice-double" class="hidden space-y-4">
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">1ሀ. ፈጣን ክልል ይምረጡ</label>
                        <div class="grid grid-cols-3 gap-2.5">
                            <button type="button" onclick="selectDoubleDiceBet('low', null)" id="btnDouble-low"
                                class="double-dice-btn p-3 rounded-2xl border-2 border-amber-500 bg-amber-500/15 text-white flex flex-col items-center transition cursor-pointer">
                                <span class="text-sm sm:text-base font-black text-amber-400">ዝቅተኛ (2-6)</span>
                                <span class="text-[11px] text-slate-300">2.2x</span>
                            </button>
                            <button type="button" onclick="selectDoubleDiceBet('lucky7', null)" id="btnDouble-lucky7"
                                class="double-dice-btn p-3 rounded-2xl border-2 border-slate-800 bg-slate-950/60 hover:border-slate-700 text-slate-300 flex flex-col items-center transition cursor-pointer">
                                <span class="text-sm sm:text-base font-black">እድለኛ 7</span>
                                <span class="text-[11px] text-slate-400">5x</span>
                            </button>
                            <button type="button" onclick="selectDoubleDiceBet('high', null)" id="btnDouble-high"
                                class="double-dice-btn p-3 rounded-2xl border-2 border-slate-800 bg-slate-950/60 hover:border-slate-700 text-slate-300 flex flex-col items-center transition cursor-pointer">
                                <span class="text-sm sm:text-base font-black">ከፍተኛ (8-12)</span>
                                <span class="text-[11px] text-slate-400">2.2x</span>
                            </button>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">1ለ. ወይም ትክክለኛ ድምር ይምረጡ (ከ 2 እስከ 12)</label>
                        <div id="doubleSumGrid" class="grid grid-cols-4 sm:grid-cols-6 gap-2">
                            <!-- Populated via JS for sums 2 to 12 with exact payouts -->
                        </div>
                    </div>
                </div>

                <!-- MODE C: D100 HIGH NUMBER CONTROLS (1-100) -->
                <div id="controls-dice-d100" class="hidden space-y-4">
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">1ሀ. ፈጣን ክልል ይምረጡ (1 - 100)</label>
                        <div class="grid grid-cols-2 sm:grid-cols-5 gap-2">
                            <button type="button" onclick="setD100Preset('under', 26, 'p1')" id="d100Preset-p1"
                                class="d100-preset-btn p-2.5 rounded-xl border-2 border-slate-800 bg-slate-950/60 hover:border-slate-700 text-slate-200 flex flex-col items-center transition cursor-pointer">
                                <span class="text-xs font-black">1 - 25</span>
                                <span class="text-[11px] text-emerald-400 font-bold">3.8x</span>
                            </button>
                            <button type="button" onclick="setD100Preset('under', 51, 'p2')" id="d100Preset-p2"
                                class="d100-preset-btn p-2.5 rounded-xl border-2 border-amber-500 bg-amber-500/15 text-amber-400 flex flex-col items-center transition cursor-pointer">
                                <span class="text-xs font-black">1 - 50</span>
                                <span class="text-[11px] text-emerald-400 font-bold">1.95x</span>
                            </button>
                            <button type="button" onclick="setD100Preset('over', 50, 'p3')" id="d100Preset-p3"
                                class="d100-preset-btn p-2.5 rounded-xl border-2 border-slate-800 bg-slate-950/60 hover:border-slate-700 text-slate-200 flex flex-col items-center transition cursor-pointer">
                                <span class="text-xs font-black">51 - 100</span>
                                <span class="text-[11px] text-emerald-400 font-bold">1.95x</span>
                            </button>
                            <button type="button" onclick="setD100Preset('over', 75, 'p4')" id="d100Preset-p4"
                                class="d100-preset-btn p-2.5 rounded-xl border-2 border-slate-800 bg-slate-950/60 hover:border-slate-700 text-slate-200 flex flex-col items-center transition cursor-pointer">
                                <span class="text-xs font-black">76 - 100</span>
                                <span class="text-[11px] text-emerald-400 font-bold">3.8x</span>
                            </button>
                            <button type="button" onclick="setD100Preset('over', 89, 'p5')" id="d100Preset-p5"
                                class="d100-preset-btn col-span-2 sm:col-span-1 p-2.5 rounded-xl border-2 border-slate-800 bg-slate-950/60 hover:border-slate-700 text-slate-200 flex flex-col items-center transition cursor-pointer">
                                <span class="text-xs font-black">90 - 100</span>
                                <span class="text-[11px] text-amber-400 font-bold">8.8x</span>
                            </button>
                        </div>
                    </div>

                    <!-- Custom Target Slider -->
                    <div class="bg-slate-950/70 border border-slate-800 rounded-2xl p-4 space-y-3">
                        <div class="flex flex-wrap items-center justify-between gap-2">
                            <div class="flex items-center gap-2">
                                <button type="button" onclick="setD100Direction('under')" id="btnD100Under"
                                    class="px-3.5 py-1.5 rounded-xl text-xs font-black bg-amber-500 text-slate-950 transition cursor-pointer">
                                    በታች (Under)
                                </button>
                                <button type="button" onclick="setD100Direction('over')" id="btnD100Over"
