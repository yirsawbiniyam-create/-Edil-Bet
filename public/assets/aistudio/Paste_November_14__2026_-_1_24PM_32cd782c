    <script>
        // --- Game State ---
        const STORAGE_KEY = 'ethio_virtual_betting_v2';
        const DOUBLE_SUM_MULTIPLIERS = {
            2: 30,
            3: 15,
            4: 10,
            5: 8,
            6: 6,
            7: 5,
            8: 6,
            9: 8,
            10: 10,
            11: 15,
            12: 30
        };

        let state = {
            balance: 1000,
            activeGame: 'dice',      // 'dice' | 'coin' | 'lucky'
            diceSubMode: 'single',   // 'single' | 'double' | 'd100'
            singleDiceMode: 'low',   // 'low' | 'high' | 'exact'
            singleDiceExact: 6,      // 1..6
            doubleDiceMode: 'low',   // 'low' | 'lucky7' | 'high' | 'exact'
            doubleDiceExact: 7,      // 2..12
            d100Direction: 'under',  // 'under' | 'over'
            d100Target: 51,          // 2..99
            coinChoice: 'heads',     // 'heads' | 'tails'
            luckyChoice: 7,          // 1..20
            isRolling: false,
            soundEnabled: true,
            history: []
        };

        // --- Web Audio API Sound Synthesizer (Zero external assets needed) ---
        let audioCtx = null;

        function ensureAudioContext() {
            if (!audioCtx) {
                const AudioContext = window.AudioContext || window.webkitAudioContext;
                audioCtx = new AudioContext();
            }
            if (audioCtx.state === 'suspended') {
                audioCtx.resume();
            }
        }

        function playSound(type) {
            if (!state.soundEnabled) return;
            try {
                ensureAudioContext();
                const now = audioCtx.currentTime;

                if (type === 'click') {
                    const osc = audioCtx.createOscillator();
                    const gain = audioCtx.createGain();
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(520, now);
                    osc.frequency.exponentialRampToValueAtTime(300, now + 0.06);
                    gain.gain.setValueAtTime(0.12, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.06);
                    osc.connect(gain);
                    gain.connect(audioCtx.destination);
                    osc.start(now);
                    osc.stop(now + 0.06);
                } else if (type === 'roll') {
                    // Rapid mechanical ticks
                    for (let i = 0; i < 6; i++) {
                        const t = now + i * 0.11;
                        const osc = audioCtx.createOscillator();
                        const gain = audioCtx.createGain();
                        osc.type = 'triangle';
                        osc.frequency.setValueAtTime(240 + (i * 45), t);
                        gain.gain.setValueAtTime(0.14, t);
                        gain.gain.exponentialRampToValueAtTime(0.001, t + 0.07);
                        osc.connect(gain);
                        gain.connect(audioCtx.destination);
                        osc.start(t);
                        osc.stop(t + 0.07);
                    }
                } else if (type === 'win') {
                    // Ascending celebratory chord
                    const notes = [523.25, 659.25, 783.99, 1046.50]; // C5, E5, G5, C6
                    notes.forEach((freq, idx) => {
                        const t = now + idx * 0.08;
                        const osc = audioCtx.createOscillator();
                        const gain = audioCtx.createGain();
                        osc.type = 'triangle';
                        osc.frequency.setValueAtTime(freq, t);
                        gain.gain.setValueAtTime(0.18, t);
                        gain.gain.exponentialRampToValueAtTime(0.001, t + 0.35);
                        osc.connect(gain);
                        gain.connect(audioCtx.destination);
                        osc.start(t);
                        osc.stop(t + 0.35);
                    });
                } else if (type === 'lose') {
                    // Descending low tone
                    const osc = audioCtx.createOscillator();
                    const gain = audioCtx.createGain();
                    osc.type = 'sawtooth';
                    osc.frequency.setValueAtTime(210, now);
                    osc.frequency.linearRampToValueAtTime(110, now + 0.32);
                    gain.gain.setValueAtTime(0.14, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.34);
                    osc.connect(gain);
                    gain.connect(audioCtx.destination);
                    osc.start(now);
                    osc.stop(now + 0.34);
                }
            } catch (e) {
                // Ignore audio errors on restricted browsers
            }
        }

        function toggleSound() {
            state.soundEnabled = !state.soundEnabled;
            const icon = document.getElementById('soundIcon');
            if (state.soundEnabled) {
                icon.className = 'ph-fill ph-speaker-high text-xl text-amber-400';
                playSound('click');
                showToast('ድምጽ በርቷል', 'info');
            } else {
                icon.className = 'ph-fill ph-speaker-slash text-xl text-slate-500';
                showToast('ድምጽ ጠፍቷል', 'info');
            }
            saveState();
        }

        // --- Formatting Helpers ---
        function formatETB(num) {
            return Number(num).toLocaleString('en-US', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            }) + ' ብር';
        }

        // --- Persistence ---
        function loadState() {
            try {
                const raw = localStorage.getItem(STORAGE_KEY);
                if (raw) {
                    const parsed = JSON.parse(raw);
                    if (typeof parsed.balance === 'number') state.balance = parsed.balance;
                    if (Array.isArray(parsed.history)) state.history = parsed.history;
                    if (typeof parsed.soundEnabled === 'boolean') state.soundEnabled = parsed.soundEnabled;
                }
            } catch (e) {
                console.warn('Could not load saved game state');
            }
        }

        function saveState() {
            try {
                localStorage.setItem(STORAGE_KEY, JSON.stringify({
                    balance: state.balance,
                    history: state.history.slice(0, 25),
                    soundEnabled: state.soundEnabled
                }));
            } catch (e) {}
        }

        // --- UI Updates ---
        function updateBalanceUI() {
            document.getElementById('balanceDisplay').textContent = formatETB(state.balance);
            const topUpBtn = document.getElementById('topUpBtn');
            if (state.balance < 50) {
                topUpBtn.classList.add('animate-pulse', 'ring-2', 'ring-emerald-300');
            } else {
                topUpBtn.classList.remove('animate-pulse', 'ring-2', 'ring-emerald-300');
            }
        }

        function topUpBalance() {
            if (state.isRolling) return;
            playSound('win');
            if (state.balance < 1000) {
                state.balance = 1000;
                showToast('ቀሪ ሂሳብዎ ወደ 1,000.00 ብር ተሞልቷል!', 'win');
            } else {
                state.balance += 1000;
                showToast('+1,000.00 ብር ተጨምሯል!', 'win');
            }
            saveState();
            updateBalanceUI();
            updatePotentialWin();
        }

        // --- Game Switching ---
        function switchGame(gameKey) {
            if (state.isRolling) return;
            playSound('click');
            state.activeGame = gameKey;

            // Update Tab Styles
            document.querySelectorAll('.game-tab').forEach(btn => {
                btn.className = 'game-tab py-3 px-3 rounded-xl font-bold text-xs sm:text-sm flex flex-col sm:flex-row items-center justify-center gap-1.5 sm:gap-2 transition cursor-pointer text-slate-300 hover:bg-slate-800';
            });
            const activeTab = document.getElementById(`tab-${gameKey}`);
            activeTab.className = 'game-tab py-3 px-3 rounded-xl font-bold text-xs sm:text-sm flex flex-col sm:flex-row items-center justify-center gap-1.5 sm:gap-2 transition cursor-pointer bg-gradient-to-r from-amber-500 to-amber-600 text-slate-950 shadow-md';

            // Show Active Panel
            document.querySelectorAll('.game-panel').forEach(p => p.classList.add('hidden'));
            document.getElementById(`panel-${gameKey}`).classList.remove('hidden');

            // Hide previous result banner
            document.getElementById('resultBanner').classList.add('hidden');

            updatePotentialWin();
        }

        // --- Dice Sub-Mode & Option Handlers ---
        function setDiceSubMode(subMode) {
            if (state.isRolling) return;
            playSound('click');
            state.diceSubMode = subMode;

            // Update sub-mode tab buttons
            document.querySelectorAll('.dice-sub-btn').forEach(btn => {
                btn.className = 'dice-sub-btn py-2.5 px-2 rounded-xl text-xs sm:text-sm font-extrabold transition cursor-pointer text-slate-300 hover:bg-slate-800';
            });
            document.getElementById(`diceSub-${subMode}`).className = 'dice-sub-btn py-2.5 px-2 rounded-xl text-xs sm:text-sm font-extrabold transition cursor-pointer bg-amber-500 text-slate-950 shadow';

            // Toggle Visual Stages & Control Panels
            document.getElementById('diceStageSingle').classList.toggle('hidden', subMode !== 'single');
            document.getElementById('diceStageDouble').classList.toggle('hidden', subMode !== 'double');
            document.getElementById('diceStageD100').classList.toggle('hidden', subMode !== 'd100');

            document.getElementById('controls-dice-single').classList.toggle('hidden', subMode !== 'single');
            document.getElementById('controls-dice-double').classList.toggle('hidden', subMode !== 'double');
            document.getElementById('controls-dice-d100').classList.toggle('hidden', subMode !== 'd100');

            document.getElementById('resultBanner').classList.add('hidden');
            updatePotentialWin();
        }

        function selectSingleDiceBet(mode, exactNum) {
            if (state.isRolling) return;
            playSound('click');
            state.singleDiceMode = mode;
            if (exactNum !== null) state.singleDiceExact = exactNum;

            // Reset all single dice buttons
            ['low', 'high'].forEach(key => {
                const el = document.getElementById(`btnSingle-${key}`);
                el.className = 'single-dice-btn p-3.5 rounded-2xl border-2 border-slate-800 bg-slate-950/60 hover:border-slate-700 text-slate-300 flex flex-col items-center justify-center transition cursor-pointer';
                el.querySelector('span').classList.remove('text-amber-400');
            });
            for (let i = 1; i <= 6; i++) {
                const el = document.getElementById(`btnSingleExact-${i}`);
                el.className = 'single-dice-btn py-3 rounded-xl border-2 border-slate-800 bg-slate-950/60 hover:border-slate-700 text-slate-200 font-black text-lg transition cursor-pointer';
            }

            if (mode === 'low' || mode === 'high') {
                const active = document.getElementById(`btnSingle-${mode}`);
                active.className = 'single-dice-btn p-3.5 rounded-2xl border-2 border-amber-500 bg-amber-500/15 text-white flex flex-col items-center justify-center transition cursor-pointer';
                active.querySelector('span').classList.add('text-amber-400');
            } else {
                const active = document.getElementById(`btnSingleExact-${exactNum}`);
                active.className = 'single-dice-btn py-3 rounded-xl border-2 border-amber-500 bg-amber-500/20 text-amber-400 font-black text-lg transition cursor-pointer';
            }

            updatePotentialWin();
        }

        function buildDoubleDiceGrid() {
            const grid = document.getElementById('doubleSumGrid');
            grid.innerHTML = '';
            for (let sum = 2; sum <= 12; sum++) {
                const mult = DOUBLE_SUM_MULTIPLIERS[sum];
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.id = `btnDoubleExact-${sum}`;
                btn.onclick = () => selectDoubleDiceBet('exact', sum);
                btn.className = 'double-dice-btn p-2.5 rounded-xl border-2 border-slate-800 bg-slate-950/60 hover:border-slate-700 text-slate-200 flex flex-col items-center transition cursor-pointer';
                btn.innerHTML = `
                    <span class="text-base font-black">${sum}</span>
                    <span class="text-[10px] font-bold text-emerald-400">${mult}x</span>
                `;
                grid.appendChild(btn);
            }
        }

        function selectDoubleDiceBet(mode, exactSum) {
            if (state.isRolling) return;
            playSound('click');
            state.doubleDiceMode = mode;
            if (exactSum !== null) state.doubleDiceExact = exactSum;

            ['low', 'lucky7', 'high'].forEach(key => {
                const el = document.getElementById(`btnDouble-${key}`);
                el.className = 'double-dice-btn p-3 rounded-2xl border-2 border-slate-800 bg-slate-950/60 hover:border-slate-700 text-slate-300 flex flex-col items-center transition cursor-pointer';
                el.querySelector('span').classList.remove('text-amber-400');
            });

            for (let s = 2; s <= 12; s++) {
                const el = document.getElementById(`btnDoubleExact-${s}`);
                if (el) {
                    el.className = 'double-dice-btn p-2.5 rounded-xl border-2 border-slate-800 bg-slate-950/60 hover:border-slate-700 text-slate-200 flex flex-col items-center transition cursor-pointer';
                }
            }

            if (mode !== 'exact') {
                const active = document.getElementById(`btnDouble-${mode}`);
                active.className = 'double-dice-btn p-3 rounded-2xl border-2 border-amber-500 bg-amber-500/15 text-white flex flex-col items-center transition cursor-pointer';
                active.querySelector('span').classList.add('text-amber-400');
            } else {
                const active = document.getElementById(`btnDoubleExact-${exactSum}`);
                if (active) {
                    active.className = 'double-dice-btn p-2.5 rounded-xl border-2 border-amber-500 bg-amber-500/20 text-amber-400 flex flex-col items-center transition cursor-pointer';
                }
            }

            updatePotentialWin();
        }

        function clearD100PresetHighlight() {
            document.querySelectorAll('.d100-preset-btn').forEach(btn => {
                btn.className = 'd100-preset-btn p-2.5 rounded-xl border-2 border-slate-800 bg-slate-950/60 hover:border-slate-700 text-slate-200 flex flex-col items-center transition cursor-pointer';
            });
            const p5 = document.getElementById('d100Preset-p5');
            if (p5) p5.classList.add('col-span-2', 'sm:col-span-1');
        }

        function setD100Preset(direction, target, presetId) {
            if (state.isRolling) return;
            playSound('click');
            state.d100Direction = direction;
            state.d100Target = target;
            document.getElementById('d100TargetSlider').value = target;

            clearD100PresetHighlight();
            const active = document.getElementById(`d100Preset-${presetId}`);
            if (active) {
                active.className = 'd100-preset-btn p-2.5 rounded-xl border-2 border-amber-500 bg-amber-500/15 text-amber-400 flex flex-col items-center transition cursor-pointer';
                if (presetId === 'p5') active.classList.add('col-span-2', 'sm:col-span-1');
            }

            syncD100ControlsUI();
            updatePotentialWin();
        }

        function setD100Direction(direction) {
            if (state.isRolling) return;
            playSound('click');
            state.d100Direction = direction;
            clearD100PresetHighlight();
            syncD100ControlsUI();
            updatePotentialWin();
        }

        function onD100SliderChange() {
            state.d100Target = parseInt(document.getElementById('d100TargetSlider').value, 10) || 50;
            clearD100PresetHighlight();
            syncD100ControlsUI();
            updatePotentialWin();
        }

        function getD100Stats() {
            const target = state.d100Target;
            let winCount = 0;
            let rangeText = '';
            if (state.d100Direction === 'under') {
                winCount = Math.max(1, target - 1);
                rangeText = `ከ ${target} በታች (1 - ${target - 1})`;
            } else {
                winCount = Math.max(1, 100 - target);
                rangeText = `ከ ${target} በላይ (${target + 1} - 100)`;
            }
            const multiplier = Number((97 / winCount).toFixed(2));
            return { winCount, rangeText, multiplier };
        }

        function syncD100ControlsUI() {
            const underBtn = document.getElementById('btnD100Under');
            const overBtn = document.getElementById('btnD100Over');
            if (state.d100Direction === 'under') {
                underBtn.className = 'px-3.5 py-1.5 rounded-xl text-xs font-black bg-amber-500 text-slate-950 transition cursor-pointer';
                overBtn.className = 'px-3.5 py-1.5 rounded-xl text-xs font-black bg-slate-800 text-slate-300 hover:bg-slate-700 transition cursor-pointer';
            } else {
                overBtn.className = 'px-3.5 py-1.5 rounded-xl text-xs font-black bg-amber-500 text-slate-950 transition cursor-pointer';
                underBtn.className = 'px-3.5 py-1.5 rounded-xl text-xs font-black bg-slate-800 text-slate-300 hover:bg-slate-700 transition cursor-pointer';
            }
            const stats = getD100Stats();
            document.getElementById('d100RuleSummary').textContent = `${stats.rangeText} • እድል: ${stats.winCount}%`;
        }

        function selectCoinChoice(choice) {
            if (state.isRolling) return;
            playSound('click');
            state.coinChoice = choice;
            const headsBtn = document.getElementById('btnCoinHeads');
            const tailsBtn = document.getElementById('btnCoinTails');

            if (choice === 'heads') {
                headsBtn.className = 'p-4 rounded-2xl border-2 border-amber-500 bg-amber-500/15 text-white flex items-center justify-center gap-3 transition cursor-pointer';
                headsBtn.querySelector('i').className = 'ph-fill ph-crown text-2xl text-amber-400';
                headsBtn.querySelector('span').className = 'text-base sm:text-lg font-black text-amber-400';

                tailsBtn.className = 'p-4 rounded-2xl border-2 border-slate-800 bg-slate-950/60 hover:border-slate-700 text-slate-300 flex items-center justify-center gap-3 transition cursor-pointer';
                tailsBtn.querySelector('i').className = 'ph-fill ph-sword text-2xl';
                tailsBtn.querySelector('span').className = 'text-base sm:text-lg font-black';
            } else {
                tailsBtn.className = 'p-4 rounded-2xl border-2 border-amber-500 bg-amber-500/15 text-white flex items-center justify-center gap-3 transition cursor-pointer';
                tailsBtn.querySelector('i').className = 'ph-fill ph-sword text-2xl text-amber-400';
                tailsBtn.querySelector('span').className = 'text-base sm:text-lg font-black text-amber-400';

                headsBtn.className = 'p-4 rounded-2xl border-2 border-slate-800 bg-slate-950/60 hover:border-slate-700 text-slate-300 flex items-center justify-center gap-3 transition cursor-pointer';
                headsBtn.querySelector('i').className = 'ph-fill ph-crown text-2xl';
                headsBtn.querySelector('span').className = 'text-base sm:text-lg font-black';
            }
        }

        function setBetAmount(amount) {
            if (state.isRolling) return;
            playSound('click');
            document.getElementById('betAmountInput').value = amount;
            updatePotentialWin();
        }

        function setAllInBet() {
            if (state.isRolling) return;
            playSound('click');
            const allIn = Math.floor(state.balance);
            document.getElementById('betAmountInput').value = allIn > 0 ? allIn : 0;
            updatePotentialWin();
        }

        function buildLuckyNumberGrid() {
            const grid = document.getElementById('luckyNumberGrid');
            grid.innerHTML = '';
            for (let i = 1; i <= 20; i++) {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.id = `btnLucky-${i}`;
                btn.textContent = i;
                btn.onclick = () => selectLuckyNumber(i);
                btn.className = i === state.luckyChoice
                    ? 'lucky-num-btn py-3 rounded-xl border-2 border-amber-500 bg-amber-500/20 text-amber-400 text-base sm:text-lg font-black transition cursor-pointer'
                    : 'lucky-num-btn py-3 rounded-xl border-2 border-slate-800 bg-slate-950/60 hover:border-slate-700 text-slate-300 text-base sm:text-lg font-black transition cursor-pointer';
                grid.appendChild(btn);
            }
        }

        function selectLuckyNumber(num) {
            if (state.isRolling) return;
            playSound('click');
            state.luckyChoice = num;
            for (let i = 1; i <= 20; i++) {
                const btn = document.getElementById(`btnLucky-${i}`);
                if (!btn) continue;
                if (i === num) {
                    btn.className = 'lucky-num-btn py-3 rounded-xl border-2 border-amber-500 bg-amber-500/20 text-amber-400 text-base sm:text-lg font-black transition cursor-pointer';
                } else {
                    btn.className = 'lucky-num-btn py-3 rounded-xl border-2 border-slate-800 bg-slate-950/60 hover:border-slate-700 text-slate-300 text-base sm:text-lg font-black transition cursor-pointer';
                }
            }
        }

        // --- Bet Amount Controls ---
        function getCurrentMultiplier() {
            if (state.activeGame === 'coin') return 2;
            if (state.activeGame === 'lucky') return 18;

            // Dice modes
            if (state.diceSubMode === 'single') {
                return state.singleDiceMode === 'exact' ? 5.5 : 2;
            }
            if (state.diceSubMode === 'double') {
                if (state.doubleDiceMode === 'exact') {
                    return DOUBLE_SUM_MULTIPLIERS[state.doubleDiceExact] || 5;
                }
                if (state.doubleDiceMode === 'lucky7') return 5;
                return 2.2;
            }
            if (state.diceSubMode === 'd100') {
                return getD100Stats().multiplier;
            }
            return 2;
        }

        function updatePotentialWin() {
            const bet = parseFloat(document.getElementById('betAmountInput').value) || 0;
            const multiplier = getCurrentMultiplier();
            const potential = bet * multiplier;

            document.getElementById('potentialWinHint').textContent = `ሊያሸንፉ የሚችሉት: ${formatETB(potential)} (${multiplier}x)`;
            const badge = document.getElementById('diceCurrentMultiplierBadge');
            if (badge) badge.textContent = `ሽልማት: ${multiplier}x`;

            const actionLabels = {
                dice: `ዳይሱን ወርውር (${bet > 0 ? bet : 0} ብር)`,
                coin: `ሳንቲሙን ገልብጥ (${bet > 0 ? bet : 0} ብር)`,
                lucky: `እድልህን ሞክር (${bet > 0 ? bet : 0} ብር)`
            };
            document.getElementById('playBtnText').textContent = actionLabels[state.activeGame];
        }

        // --- Render 3D-style Dice Pips ---
        function renderDiceFace(value, targetId = 'diceVisual') {
            const visual = document.getElementById(targetId);
            if (!visual) return;
            // 3x3 grid positions (1 to 9)
            const layouts = {
                1: [5],
                2: [1, 9],
                3: [1, 5, 9],
                4: [1, 3, 7, 9],
                5: [1, 3, 5, 7, 9],
                6: [1, 3, 4, 6, 7, 9]
            };
            const activeCells = layouts[value] || [5];
            let html = '';
            for (let cell = 1; cell <= 9; cell++) {
                if (activeCells.includes(cell)) {
                    const isRed = (value === 1 || (value === 5 && cell === 5));
                    html += `<div class="pip ${isRed ? 'red' : ''}"></div>`;
                } else {
                    html += `<div></div>`;
                }
            }
            visual.innerHTML = html;
        }

        // --- Core Play Execution ---
        function playCurrentGame() {
            if (state.isRolling) return;

            const bet = parseFloat(document.getElementById('betAmountInput').value);
            if (isNaN(bet) || bet <= 0) {
                showToast('እባክዎ ትክክለኛ የመወራረጃ መጠን ያስገቡ!', 'error');
                return;
            }
            if (bet > state.balance) {
                showToast('በቂ ቀሪ ሂሳብ የለዎትም! ከላይ "ሂሳብ ሙላ" የሚለውን ይጫኑ።', 'error');
                return;
            }

            // Deduct stake immediately
            state.balance -= bet;
            state.isRolling = true;
            updateBalanceUI();
            playSound('roll');

            const playBtn = document.getElementById('playActionBtn');
            playBtn.disabled = true;
            playBtn.classList.add('opacity-60', 'cursor-not-allowed');
            document.getElementById('resultBanner').classList.add('hidden');

            if (state.activeGame === 'dice') {
                runDiceRound(bet);
            } else if (state.activeGame === 'coin') {
                runCoinRound(bet);
            } else {
                runLuckyRound(bet);
            }
        }

        function runDiceRound(bet) {
            if (state.diceSubMode === 'double') {
                runDoubleDiceRound(bet);
                return;
            }
            if (state.diceSubMode === 'd100') {
                runD100DiceRound(bet);
                return;
            }

            const diceEl = document.getElementById('diceVisual');
            const statusEl = document.getElementById('diceStatusLabel');
            diceEl.classList.remove('animate-dice-roll');
            void diceEl.offsetWidth;
            diceEl.classList.add('animate-dice-roll');
            statusEl.textContent = 'ዳይሱ እየተሽከረከረ ነው...';

            const interval = setInterval(() => {
                renderDiceFace(Math.floor(Math.random() * 6) + 1, 'diceVisual');
            }, 90);

            setTimeout(() => {
                clearInterval(interval);
                const rolled = Math.floor(Math.random() * 6) + 1;
                renderDiceFace(rolled, 'diceVisual');

                let won = false;
                let choiceDesc = '';
                const mult = getCurrentMultiplier();

                if (state.singleDiceMode === 'low') {
                    won = rolled <= 3;
                    choiceDesc = 'ዝቅተኛ (1-3)';
                } else if (state.singleDiceMode === 'high') {
                    won = rolled >= 4;
                    choiceDesc = 'ከፍተኛ (4-6)';
                } else {
                    won = rolled === state.singleDiceExact;
                    choiceDesc = `ቁጥር ${state.singleDiceExact}`;
                }

                const payout = won ? Number((bet * mult).toFixed(2)) : 0;
                statusEl.textContent = `የወጣው ቁጥር: ${rolled} (ምርጫዎ: ${choiceDesc})`;

                finishRound({
                    gameName: 'ባለ 1 ዳይስ (1-6)',
                    bet: bet,
                    resultText: `ቁጥር ${rolled} ወጣ • ምርጫ: ${choiceDesc}`,
                    won: won,
                    payout: payout
                });
            }, 850);
        }

        function runDoubleDiceRound(bet) {
            const d1 = document.getElementById('diceVisual1');
            const d2 = document.getElementById('diceVisual2');
            const sumBadge = document.getElementById('doubleDiceSumBadge');
            const statusEl = document.getElementById('diceStatusLabel');

            [d1, d2].forEach(el => {
                el.classList.remove('animate-dice-roll');
                void el.offsetWidth;
                el.classList.add('animate-dice-roll');
            });
            statusEl.textContent = 'ሁለቱ ዳይሶች እየተሽከረከሩ ነው...';

            const interval = setInterval(() => {
                const r1 = Math.floor(Math.random() * 6) + 1;
                const r2 = Math.floor(Math.random() * 6) + 1;
                renderDiceFace(r1, 'diceVisual1');
                renderDiceFace(r2, 'diceVisual2');
                sumBadge.textContent = `ድምር: ${r1 + r2}`;
            }, 90);

            setTimeout(() => {
                clearInterval(interval);
                const r1 = Math.floor(Math.random() * 6) + 1;
                const r2 = Math.floor(Math.random() * 6) + 1;
                const sum = r1 + r2;

                renderDiceFace(r1, 'diceVisual1');
                renderDiceFace(r2, 'diceVisual2');
                sumBadge.textContent = `ድምር: ${sum} (${r1} + ${r2})`;

                let won = false;
                let choiceDesc = '';
                const mult = getCurrentMultiplier();

                if (state.doubleDiceMode === 'low') {
                    won = sum >= 2 && sum <= 6;
                    choiceDesc = 'ዝቅተኛ (2-6)';
                } else if (state.doubleDiceMode === 'lucky7') {
                    won = sum === 7;
                    choiceDesc = 'እድለኛ 7';
                } else if (state.doubleDiceMode === 'high') {
                    won = sum >= 8 && sum <= 12;
                    choiceDesc = 'ከፍተኛ (8-12)';
                } else {
                    won = sum === state.doubleDiceExact;
                    choiceDesc = `ድምር ${state.doubleDiceExact}`;
                }

                const payout = won ? Number((bet * mult).toFixed(2)) : 0;
                statusEl.textContent = `ውጤት: ${r1} + ${r2} = ${sum} (ምርጫዎ: ${choiceDesc})`;

                finishRound({
                    gameName: 'ባለ 2 ዳይስ (2-12)',
                    bet: bet,
                    resultText: `ድምር ${sum} (${r1}+${r2}) • ምርጫ: ${choiceDesc}`,
                    won: won,
                    payout: payout
                });
            }, 900);
        }

        function runD100DiceRound(bet) {
            const numDisplay = document.getElementById('d100NumberDisplay');
            const statusEl = document.getElementById('diceStatusLabel');
            const stats = getD100Stats();

            statusEl.textContent = 'ባለ 100 ዳይስ ቁጥር እየወጣ ነው...';

            const interval = setInterval(() => {
                numDisplay.textContent = Math.floor(Math.random() * 100) + 1;
            }, 55);

            setTimeout(() => {
                clearInterval(interval);
                const rolled = Math.floor(Math.random() * 100) + 1;
                numDisplay.textContent = rolled;

                const won = state.d100Direction === 'under'
                    ? rolled < state.d100Target
                    : rolled > state.d100Target;

                const payout = won ? Number((bet * stats.multiplier).toFixed(2)) : 0;
                statusEl.textContent = `የወጣው ቁጥር: ${rolled} (ምርጫዎ: ${stats.rangeText})`;

                finishRound({
                    gameName: 'ባለ 100 ዳይስ (1-100)',
                    bet: bet,
                    resultText: `ቁጥር ${rolled} • ${stats.rangeText}`,
                    won: won,
                    payout: payout
                });
            }, 900);
        }

        function runCoinRound(bet) {
            const coinEl = document.getElementById('coinVisual');
            const iconEl = document.getElementById('coinIcon');
            const textEl = document.getElementById('coinFaceText');
            const statusEl = document.getElementById('coinStatusLabel');

            coinEl.classList.remove('animate-coin-flip');
            void coinEl.offsetWidth;
            coinEl.classList.add('animate-coin-flip');
            statusEl.textContent = 'ሳንቲሙ በአየር ላይ እየተገለበጠ ነው...';

            setTimeout(() => {
                const outcome = Math.random() < 0.5 ? 'heads' : 'tails';
                const won = outcome === state.coinChoice;
                const payout = won ? bet * 2 : 0;

                if (outcome === 'heads') {
                    iconEl.className = 'ph-fill ph-crown text-4xl';
                    textEl.textContent = 'ዘውድ';
                    statusEl.textContent = 'ውጤት: ዘውድ (Heads)';
                } else {
                    iconEl.className = 'ph-fill ph-sword text-4xl';
                    textEl.textContent = 'ጎራዴ';
                    statusEl.textContent = 'ውጤት: ጎራዴ (Tails)';
                }

                finishRound({
                    gameName: 'የሳንቲም ውርርድ',
                    bet: bet,
                    resultText: `${outcome === 'heads' ? 'ዘውድ' : 'ጎራዴ'} ወጣ`,
                    won: won,
                    payout: payout
                });
            }, 950);
        }

        function runLuckyRound(bet) {
            const numDisplay = document.getElementById('luckyNumberDisplay');
            const statusEl = document.getElementById('luckyStatusLabel');
            statusEl.textContent = 'ከ 1 እስከ 20 የእድል ቁጥሩ እየተመረጠ ነው...';

            let ticks = 0;
            const interval = setInterval(() => {
                ticks++;
                numDisplay.textContent = (ticks % 20) + 1;
            }, 60);

            setTimeout(() => {
                clearInterval(interval);
                const winningNum = Math.floor(Math.random() * 20) + 1;
                numDisplay.textContent = winningNum;

                const won = winningNum === state.luckyChoice;
                const payout = won ? bet * 18 : 0;

                statusEl.textContent = `የወጣው የእድል ቁጥር: ${winningNum} (የእርስዎ ምርጫ: ${state.luckyChoice})`;
                finishRound({
                    gameName: 'የእድል ቁጥር (1-20)',
                    bet: bet,
                    resultText: `ቁጥር ${winningNum} (ምርጫ: ${state.luckyChoice})`,
                    won: won,
                    payout: payout
                });
            }, 950);
        }

        function finishRound({ gameName, bet, resultText, won, payout }) {
            state.isRolling = false;
            const playBtn = document.getElementById('playActionBtn');
            playBtn.disabled = false;
            playBtn.classList.remove('opacity-60', 'cursor-not-allowed');

            if (won) {
                state.balance += payout;
                playSound('win');
            } else {
                playSound('lose');
            }

            // Show Result Banner
            const banner = document.getElementById('resultBanner');
            const title = document.getElementById('resultBannerTitle');
            const sub = document.getElementById('resultBannerSub');

            banner.classList.remove('hidden', 'bg-emerald-500/15', 'border-emerald-500/40', 'bg-rose-500/15', 'border-rose-500/40', 'animate-pop-win');
            void banner.offsetWidth;
            banner.classList.add('animate-pop-win');

            if (won) {
                banner.classList.add('bg-emerald-500/15', 'border-emerald-500/40');
                title.className = 'text-lg sm:text-xl font-black text-emerald-400';
                title.textContent = `🎉 እንኳን ደስ አለዎት! ${formatETB(payout)} አሸንፈዋል!`;
                sub.className = 'text-xs sm:text-sm mt-1 font-medium text-emerald-200';
                sub.textContent = `${gameName} • ${resultText}`;
            } else {
                banner.classList.add('bg-rose-500/15', 'border-rose-500/40');
                title.className = 'text-lg sm:text-xl font-black text-rose-400';
                title.textContent = `😔 በዚህ ዙር አልተሳካም (-${formatETB(bet)})`;
                sub.className = 'text-xs sm:text-sm mt-1 font-medium text-rose-200';
                sub.textContent = `${gameName} • ${resultText} — እንደገና ይሞክሩ!`;
            }

            // Add to History
            state.history.unshift({
                id: Date.now(),
                gameName,
                bet,
                resultText,
                won,
                payout
            });

            saveState();
            updateBalanceUI();
            renderHistory();
        }

        // --- History Table Rendering ---
        function renderHistory() {
            const tbody = document.getElementById('historyTableBody');
            const emptyEl = document.getElementById('emptyHistoryState');
            tbody.innerHTML = '';

            if (state.history.length === 0) {
                emptyEl.classList.remove('hidden');
                return;
            }
            emptyEl.classList.add('hidden');

            state.history.slice(0, 15).forEach(item => {
                const tr = document.createElement('tr');
                tr.className = 'hover:bg-slate-800/40 transition';
                tr.innerHTML = `
                    <td class="py-3 px-3 font-bold text-slate-200 whitespace-nowrap">${item.gameName}</td>
                    <td class="py-3 px-3 text-slate-300 whitespace-nowrap">${formatETB(item.bet)}</td>
                    <td class="py-3 px-3 text-slate-400">${item.resultText}</td>
                    <td class="py-3 px-3 text-right font-extrabold whitespace-nowrap ${item.won ? 'text-emerald-400' : 'text-rose-400'}">
                        ${item.won ? '+' + formatETB(item.payout) : '-' + formatETB(item.bet)}
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function clearHistory() {
            if (state.history.length === 0) return;
            playSound('click');
            state.history = [];
            saveState();
            renderHistory();
            showToast('የጨዋታ ታሪክ ጸድቷል።', 'info');
        }

        // --- Custom Toast Notification ---
        let toastTimer = null;
        function showToast(message, type = 'info') {
            const banner = document.getElementById('toastBanner');
            const textEl = document.getElementById('toastText');
            const iconEl = document.getElementById('toastIcon');

            textEl.textContent = message;
            if (type === 'win') {
                iconEl.className = 'ph-fill ph-check-circle text-2xl text-emerald-400';
            } else if (type === 'error') {
                iconEl.className = 'ph-fill ph-warning-circle text-2xl text-rose-400';
            } else {
                iconEl.className = 'ph-fill ph-info text-2xl text-amber-400';
            }

            banner.classList.remove('translate-y-28', 'opacity-0');
            clearTimeout(toastTimer);
            toastTimer = setTimeout(() => {
                banner.classList.add('translate-y-28', 'opacity-0');
            }, 3000);
        }

        // --- Initialize on Window Load ---
        window.addEventListener('DOMContentLoaded', () => {
            loadState();
            buildDoubleDiceGrid();
            buildLuckyNumberGrid();
            renderDiceFace(4, 'diceVisual1');
            renderDiceFace(3, 'diceVisual2');
            syncD100ControlsUI();
            updateBalanceUI();
            updatePotentialWin();
            renderHistory();
            if (!state.soundEnabled) {
                document.getElementById('soundIcon').className = 'ph-fill ph-speaker-slash text-xl text-slate-500';
            }
        });
    </script>
</body>
</html>